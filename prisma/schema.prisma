generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrationProvider { GOOGLE }
enum IntegrationService { GMAIL DRIVE PHOTOS YOUTUBE ADS CALENDAR SHEETS ANALYTICS SEARCH_CONSOLE BUSINESS_PROFILE CONTACTS TASKS DOCS FORMS }
enum IntegrationStatus { CONNECTED DISCONNECTED ERROR REAUTH_REQUIRED }
enum AutomationStatus { DRAFT ACTIVE PAUSED ERROR }
enum RunStatus { QUEUED RUNNING SUCCEEDED FAILED CANCELLED }

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  integrations Integration[]
  automations Automation[]
  automationRuns AutomationRun[]
  jobs Job[]
  auditLogs AuditLog[]
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Integration {
  id String @id @default(cuid())
  userId String
  provider IntegrationProvider
  service IntegrationService
  status IntegrationStatus @default(CONNECTED)
  googleAccountId String?
  googleEmail String?
  scopes String[]
  accessTokenEnc String?
  refreshTokenEnc String?
  accessTokenExpires DateTime?
  metadata Json?
  lastSyncAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider, service])
  @@index([userId])
}

model Automation {
  id String @id @default(cuid())
  userId String
  name String
  description String?
  trigger Json
  actions Json
  status AutomationStatus @default(DRAFT)
  schedule String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AutomationRun[]
  @@index([userId, status])
}

model AutomationRun {
  id String @id @default(cuid())
  automationId String
  userId String
  status RunStatus @default(QUEUED)
  triggerData Json?
  result Json?
  error String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([automationId, createdAt])
  @@index([userId, createdAt])
}

model Job {
  id String @id @default(cuid())
  userId String
  type String
  payload Json
  status RunStatus @default(QUEUED)
  attempts Int @default(0)
  runAfter DateTime?
  lockedAt DateTime?
  completedAt DateTime?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, runAfter])
}

model AuditLog {
  id String @id @default(cuid())
  userId String
  action String
  service String?
  resourceId String?
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
