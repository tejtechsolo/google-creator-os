# ============================================================
# Google Creator OS — complete environment template
# Copy to .env.local. NEVER commit real secrets.
# ============================================================

# -------------------- Application --------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# -------------------- Database --------------------
# PostgreSQL 15+ / Supabase PostgreSQL / Neon / other PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/google_creator_os"

# -------------------- Security --------------------
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_RANDOM_SECRET"
# Generate separately: openssl rand -base64 32
CRON_SECRET="REPLACE_WITH_RANDOM_SECRET"
JOB_MAX_ATTEMPTS="5"

# -------------------- Google Cloud --------------------
GOOGLE_CLOUD_PROJECT_ID=""

# Google Cloud Console → Google Auth Platform → Clients
GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_ME"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Production:
# GOOGLE_REDIRECT_URI="https://YOUR_DOMAIN/api/auth/google/callback"

# -------------------- Google Ads --------------------
# OAuth + developer token are both required for Ads API calls.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_CUSTOMER_ID=""

# -------------------- Google Analytics --------------------
GOOGLE_ANALYTICS_PROPERTY_ID=""

# -------------------- Search Console --------------------
GOOGLE_SEARCH_CONSOLE_SITE_URL=""

# -------------------- YouTube --------------------
GOOGLE_YOUTUBE_CHANNEL_ID=""

# -------------------- Business Profile --------------------
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=""

# -------------------- Optional AI --------------------
# Used later for classification, summaries, scripts, titles and recommendations.
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""

# -------------------- Optional observability --------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# -------------------- Optional object storage --------------------
# Use for generated thumbnails/videos/assets if required.
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
