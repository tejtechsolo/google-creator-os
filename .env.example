# ============================================================
# Google Creator OS — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or production secrets to GitHub.
# ============================================================

# -------------------- Application --------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# PostgreSQL / Supabase PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/google_creator_os"

# 32+ random characters. Used as input to AES-256-GCM token encryption.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_RANDOM_SECRET"

# -------------------- Google OAuth --------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_ME"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Production example:
# GOOGLE_REDIRECT_URI="https://YOUR_DOMAIN/api/auth/google/callback"

# -------------------- Google Ads --------------------
# Required only when enabling Google Ads API.
# Developer token comes from a Google Ads Manager account API Center.
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Manager/customer ID without hyphens when applicable.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_CUSTOMER_ID=""

# -------------------- Optional Google services --------------------
# These are reserved for service-specific configuration as adapters are enabled.
GOOGLE_ANALYTICS_PROPERTY_ID=""
GOOGLE_SEARCH_CONSOLE_SITE_URL=""
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=""
GOOGLE_YOUTUBE_CHANNEL_ID=""

# -------------------- Automation --------------------
# Secret used by scheduled/webhook endpoints.
CRON_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Maximum job attempts before marking a job failed.
JOB_MAX_ATTEMPTS="5"

# -------------------- Optional AI layer --------------------
# Leave blank until an AI provider is configured.
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""

# -------------------- Optional observability --------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# -------------------- Optional production storage --------------------
# Add these only when using object storage for generated assets.
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
